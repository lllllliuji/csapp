#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
	iaddq $-8, %rdx
	jl handle_remainder

loop_unrolling:
	mrmovq (%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	mrmovq 32(%rdi), %r12
	mrmovq 40(%rdi), %r13
	mrmovq 48(%rdi), %r14
	mrmovq 56(%rdi), %rcx

num_0:
	rmmovq %r8, (%rsi)
	andq %r8, %r8
	jle num_1
	iaddq $1, %rax
num_1:
	rmmovq %r9, 8(%rsi)
	andq %r9, %r9
	jle num_2
	iaddq $1, %rax

num_2:
	rmmovq %r10, 16(%rsi)
	andq %r10, %r10
	jle num_3
	iaddq $1, %rax

num_3:
	rmmovq %r11, 24(%rsi)
	andq %r11, %r11
	jle num_4
	iaddq $1, %rax

num_4:
	rmmovq %r12, 32(%rsi)
	andq %r12, %r12
	jle num_5
	iaddq $1, %rax

num_5:
	rmmovq %r13, 40(%rsi)
	andq %r13, %r13
	jle num_6
	iaddq $1, %rax

num_6:
	rmmovq %r14, 48(%rsi)
	andq %r14, %r14
	jle num_7
	iaddq $1, %rax

num_7:
	rmmovq %rcx, 56(%rsi)
	andq %rcx, %rcx
	jle update
	iaddq $1, %rax

update:
	iaddq $64, %rdi
	iaddq $64, %rsi
	iaddq $-8, %rdx
	jge loop_unrolling

handle_remainder:
	iaddq $4, %rdx
	jl remainder_0_to_3

remainder_4_to_7:
	iaddq $-2, %rdx
	jl remainder_4_to_5

remainder_6_to_7:
	mrmovq 40(%rdi), %rbx
	je remainder_6
	mrmovq 48(%rdi), %rbx
	jmp remainder_7

remainder_4_to_5:
	iaddq $1, %rdx
	mrmovq 32(%rdi), %rbx
	je remainder_5
	mrmovq 24(%rdi), %rbx
	jmp remainder_4

remainder_0_to_3:
	iaddq $2, %rdx
	jl remainder_0_to_1

remainder_2_to_3:
	mrmovq 8(%rdi), %rbx
	je remainder_2
	mrmovq 16(%rdi), %rbx
	jmp remainder_3

remainder_0_to_1:
	iaddq $1, %rdx
	mrmovq (%rdi), %rbx
	je remainder_1
	ret

remainder_7:
	andq %rbx, %rbx
	rmmovq %rbx, 48(%rsi)
	mrmovq 40(%rdi), %rbx
	jle remainder_6
	iaddq $1, %rax
	
remainder_6:
	andq %rbx, %rbx
	rmmovq %rbx, 40(%rsi)
	mrmovq 32(%rdi), %rbx
	jle remainder_5
	iaddq $1, %rax

remainder_5:
	andq %rbx, %rbx
	rmmovq %rbx, 32(%rsi)
	mrmovq 24(%rdi), %rbx
	jle remainder_4
	iaddq $1, %rax

remainder_4:
	andq %rbx, %rbx
	rmmovq %rbx, 24(%rsi)
	mrmovq 16(%rdi), %rbx
	jle remainder_3
	iaddq $1, %rax
	
remainder_3:
	andq %rbx, %rbx
	rmmovq %rbx, 16(%rsi)
	mrmovq 8(%rdi), %rbx
	jle remainder_2
	iaddq $1, %rax

remainder_2:
	andq %rbx, %rbx
	rmmovq %rbx, 8(%rsi)
	mrmovq (%rdi), %rbx
	jle remainder_1
	iaddq $1, %rax

remainder_1:
	andq %rbx, %rbx
	rmmovq %rbx, (%rsi)
	jle Done
	iaddq $1, %rax
##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
