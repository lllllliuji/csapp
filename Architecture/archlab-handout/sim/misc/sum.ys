        .pos 0
        irmovq  stack, %rsp
        call main
        halt

# Sample linked list
        .align 8
ele1:
        .quad 0x000a
        .quad ele2
ele2:
        .quad 0x00b0
        .quad ele3
ele3:
        .quad 0x0c00
        .quad ele4
ele4:
        .quad 0xd000
        .quad 0

main:
        irmovq ele1, %rdi
        call sum
        ret
sum:
        irmovq $8, %r8          
        xorq %rax, %rax
        andq %rdi, %rdi
        jmp     test
loop:
        mrmovq (%rdi), %r10
        addq %r10, %rax
        mrmovq $0x8(%rdi), %rdi
        andq %rdi, %rdi
test:
        jne     loop
        ret

        .pos 0x200
stack:

