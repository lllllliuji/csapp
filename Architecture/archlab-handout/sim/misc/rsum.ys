        .pos 0
        irmovq  stack, %rsp
        call main
        halt

# Sample linked list
        .align 8
ele1:
        .quad 0x000a
        .quad ele2
ele2:
        .quad 0x00b0
        .quad ele3
ele3:
        .quad 0x0c00
        .quad ele4
ele4:
        .quad 0xd000
        .quad 0

main:
        irmovq ele1, %rdi
        call rsum
        ret

rsum:
        irmovq $8, %r8
        xorq %rax, %rax
        andq %rdi, %rdi
        je     end                  # stop when 0
        mrmovq (%rdi), %r9          # val = ls->val
        pushq %r9                   # save val in stack
        mrmovq $0x8(%rdi), %rdi
        call rsum
        popq %r9
        addq %r9, %rax
        ret
end:
        ret

        .pos 0x200
stack:

